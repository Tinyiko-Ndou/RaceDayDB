@model IEnumerable<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<h2>Manage Events</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New Event
    </a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Event</th>
            <th>Type</th>
            <th>Date</th>
            <th>Location</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventName</td>
                <td>@item.EventType</td>
                <td>@item.EventDate.ToShortDateString()</td>
                <td>@item.City, @item.Province</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.EventID"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.EventID"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
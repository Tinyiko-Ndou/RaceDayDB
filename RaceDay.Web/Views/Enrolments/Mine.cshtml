@model IEnumerable<RaceDay.Web.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<h2>My Enrolments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Location</th>
            <th>Enrolment Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventName</td>
                <td>@item.EventDate.ToShortDateString()</td>
                <td>@item.Location</td>
                <td>@item.EnrolmentDate.ToShortDateString()</td>
                <td>@item.Status</td>
                <td>
                    @if (item.Status != "Cancelled")
                    {
                        <form asp-action="Cancel"
                              asp-route-id="@item.EnrolmentID"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Cancel
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
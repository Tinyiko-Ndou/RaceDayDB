@model RaceDay.Web.Models.ParticipantDashboardViewModel

@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-4">

    <h2>Participant Dashboard</h2>

    <p>Welcome to RaceDay. Manage your events and results here.</p>

    <div class="row mt-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>My Enrolments</h5>
                    <h2>@Model.MyEnrolments</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Upcoming Events</h5>
                    <h2>@Model.UpcomingEvents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Completed Events</h5>
                    <h2>@Model.CompletedEvents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>My Results</h5>
                    <h2>@Model.MyResults</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-3">

        <a asp-controller="BrowseEvents"
           asp-action="Index"
           class="btn btn-primary">
            Browse Events
        </a>

        <a asp-controller="Enrolments"
           asp-action="Index"
           class="btn btn-success">
            My Enrolments
        </a>

        <a asp-controller="Results"
           asp-action="Index"
           class="btn btn-info">
            My Results
        </a>

        <a asp-controller="Profile"
           asp-action="Index"
           class="btn btn-secondary">
            My Profile
        </a>

    </div>

</div>